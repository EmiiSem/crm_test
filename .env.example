# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Project URL из Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (или anon key). Его можно показывать в браузере: права ограничивает база.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Строка подключения Postgres из Supabase → Connect → Session pooler.
# На бесплатном тарифе прямой хост db.<project>.supabase.co часто только IPv6.
# Пользователь пулера: postgres.<project-ref>. Не должна начинаться с VITE_.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

TEST_ASSIGNER_EMAIL=anna.petrova@crm.test
TEST_ASSIGNER_PASSWORD=change-me
TEST_ASSIGNER_NAME=Анна Петрова

TEST_EXECUTOR1_EMAIL=ivan.sorokin@crm.test
TEST_EXECUTOR1_PASSWORD=change-me
TEST_EXECUTOR1_NAME=Иван Сорокин

TEST_EXECUTOR2_EMAIL=maria.lebedeva@crm.test
TEST_EXECUTOR2_PASSWORD=change-me
TEST_EXECUTOR2_NAME=Мария Лебедева
